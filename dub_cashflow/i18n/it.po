"    delete_cashflow()\n"
"elif operation in ('create', 'write', 'post'):\n"
"    # Only generate if amount_residual &gt; 0\n"
"    if records.filtered(lambda r: r.amount_residual &gt; 0):\n"
"        generate_cashflow()"
msgstr ""
"if operation == 'unlink':\n"
"    delete_cashflow()\n"
"elif operation in ('create', 'write', 'post'):\n"
"    # Genera solo se amount_residual &gt; 0\n"
"    if records.filtered(lambda r: r.amount_residual &gt; 0):\n"
"        generate_cashflow()"

