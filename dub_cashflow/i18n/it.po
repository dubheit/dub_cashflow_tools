#. module: dub_cashflow
#: model_terms:ir.actions.act_window,help:dub_cashflow.action_cashflow_dashboard
msgid ""
"The treasury dashboard shows projected cashflow across all your\n"
"                bank journals side by side. One column per bank, scaling to any\n"
"                number of banks."
msgstr ""
"Il cruscotto di tesoreria mostra il cashflow previsionale di tutti i tuoi\n"
"                registri bancari affiancati. Una colonna per banca, adattandosi a qualsiasi\n"
"                numero di banche."

