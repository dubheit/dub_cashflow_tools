<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Base scenario: the default scenario shown in the cashflow analysis.
             Configurations are attached to it by default. -->
        <record id="cashflow_scenario_base" model="cashflow.scenario">
            <field name="name">Base</field>
            <field name="sequence">1</field>
            <field name="is_default">True</field>
            <field name="color">10</field>
            <field name="description">Baseline cashflow forecast from actual data.</field>
        </record>
    </data>
</odoo>
