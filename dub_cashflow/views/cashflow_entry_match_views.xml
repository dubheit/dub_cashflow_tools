<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cashflow Entry Match List View -->
    <record id="view_cashflow_entry_match_tree" model="ir.ui.view">
        <field name="name">cashflow.entry.match.tree</field>
        <field name="model">cashflow.entry.match</field>
        <field name="arch" type="xml">
            <list>
                <field name="recurring_entry_id"/>
                <field name="recurring_date"/>
                <field name="recurring_amount"/>
                <field name="actual_entry_id"/>
                <field name="actual_date"/>
                <field name="actual_amount"/>
                <field name="amount_difference"/>
                <field name="state" widget="badge" decoration-warning="state == 'pending'" decoration-success="state == 'confirmed'" decoration-muted="state == 'rejected'"/>
                <button name="action_confirm" type="object" string="Confirm" class="btn-success" invisible="state != 'pending'"/>
                <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Cashflow Entry Match Form View -->
    <record id="view_cashflow_entry_match_form" model="ir.ui.view">
        <field name="name">cashflow.entry.match.form</field>
        <field name="model">cashflow.entry.match</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Match" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject Match" class="btn-secondary" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Recurring Entry (Forecast)">
                            <field name="recurring_entry_id"/>
                            <field name="recurring_date"/>
                            <field name="recurring_amount"/>
                        </group>
                        <group string="Actual Entry">
                            <field name="actual_entry_id"/>
                            <field name="actual_date"/>
                            <field name="actual_amount"/>
                        </group>
                    </group>
                    <group>
                        <field name="amount_difference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Cashflow Entry Match Search View -->
    <record id="view_cashflow_entry_match_search" model="ir.ui.view">
        <field name="name">cashflow.entry.match.search</field>
        <field name="model">cashflow.entry.match</field>
        <field name="arch" type="xml">
            <search>
                <field name="recurring_entry_id"/>
                <field name="actual_entry_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cashflow_entry_match" model="ir.actions.act_window">
        <field name="name">Cashflow Matches</field>
        <field name="res_model">cashflow.entry.match</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cashflow_entry_match_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No pending matches
            </p>
            <p>
                Matches are created when an actual entry matches a recurring forecast entry.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_cashflow_entry_match"
              name="Matches to Review"
              action="action_cashflow_entry_match"
              parent="dub_cashflow.menu_cashflow_root"
              sequence="30"
              groups="account.group_account_user"/>
</odoo>
