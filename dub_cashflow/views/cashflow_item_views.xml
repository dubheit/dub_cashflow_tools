<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashflow_item_tree" model="ir.ui.view">
        <field name="name">cashflow.item.tree</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="entry_id"/>
                <field name="source_model"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="category_id" optional="show"/>
                <field name="type"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="partner_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_cashflow_item_form" model="ir.ui.view">
        <field name="name">cashflow.item.form</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="entry_id"/>
                        <field name="date"/>
                        <field name="journal_id"/>
                        <field name="category_id"/>
                        <field name="type"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="partner_id"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cashflow_item" model="ir.actions.act_window">
        <field name="name">Cashflow Items</field>
        <field name="res_model">cashflow.item</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_cashflow_item_search_analysis"/>
    </record>

    <menuitem id="menu_cashflow_item" name="Items" action="action_cashflow_item" parent="dub_cashflow.menu_cashflow_root" sequence="20" groups="account.group_account_readonly"/>
</odoo>
