<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cashflow Analysis Pivot View -->
    <record id="view_cashflow_item_pivot" model="ir.ui.view">
        <field name="name">cashflow.item.pivot</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <pivot string="Cashflow Analysis">
                <field name="date" type="row" interval="month"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
                <field name="amount_signed" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Cashflow Analysis Graph View - Line chart with Cash In, Cash Out, and Net Balance -->
    <record id="view_cashflow_item_graph" model="ir.ui.view">
        <field name="name">cashflow.item.graph</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <graph string="Cashflow Analysis" type="line" stacked="0">
                <field name="date" interval="month"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
                <field name="amount_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Cashflow Bar Chart - Stacked by Entry Type -->
    <record id="view_cashflow_item_graph_bar" model="ir.ui.view">
        <field name="name">cashflow.item.graph.bar</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <graph string="Cashflow Analysis" type="bar" stacked="0">
                <field name="date" interval="month"/>
                <field name="entry_type"/>
                <field name="amount_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Cashflow Analysis Search View -->
    <record id="view_cashflow_item_search_analysis" model="ir.ui.view">
        <field name="name">cashflow.item.search.analysis</field>
        <field name="model">cashflow.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="entry_id"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="model_id"/>
                <separator/>
                <filter name="filter_cash_in" string="Cash In" domain="[('type', '=', 'in')]"/>
                <filter name="filter_cash_out" string="Cash Out" domain="[('type', '=', 'out')]"/>
                <separator/>
                <filter name="filter_forecast" string="Forecast" domain="[('entry_type', '=', 'forecast')]"/>
                <filter name="filter_actual" string="Actual" domain="[('entry_type', '=', 'actual')]"/>
                <separator/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_next_month" string="Next Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=2, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_next_3_months" string="Next 3 Months"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_year" string="This Year"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_journal" string="Bank" context="{'group_by': 'journal_id'}"/>
                <filter name="group_date_month" string="Date" context="{'group_by': 'date:month'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'type'}"/>
                <filter name="group_entry_type" string="Entry Type" context="{'group_by': 'entry_type'}"/>
                <filter name="group_model" string="Source" context="{'group_by': 'model_id'}"/>
                <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Cashflow Analysis Action -->
    <record id="action_cashflow_analysis" model="ir.actions.act_window">
        <field name="name">Cashflow Analysis</field>
        <field name="res_model">cashflow.item</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_cashflow_item_search_analysis"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cashflow data to analyze
            </p>
            <p>
                Cashflow entries are automatically generated based on your configurations.
            </p>
        </field>
    </record>

    <!-- Menu in Accounting Reporting -->
    <menuitem id="menu_cashflow_analysis"
              name="Cashflow Analysis"
              action="action_cashflow_analysis"
              parent="account.menu_finance_reports"
              sequence="50"
              groups="account.group_account_readonly"/>

</odoo>
