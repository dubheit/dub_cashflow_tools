    <!-- ==================== CASHFLOW REPORT (Monthly with Running Balance) ==================== -->

    <!-- Cashflow Report List View -->
    <record id="view_cashflow_report_tree" model="ir.ui.view">
        <field name="name">cashflow.report.tree</field>
        <field name="model">cashflow.report</field>
        <field name="arch" type="xml">
            <list string="Cashflow Report">
                <field name="month"/>
                <field name="cash_in" sum="Total In"/>
                <field name="cash_out" sum="Total Out"/>
                <field name="net" sum="Net"/>
                <field name="running_balance"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Cashflow Report Pivot View -->
    <record id="view_cashflow_report_pivot" model="ir.ui.view">
        <field name="name">cashflow.report.pivot</field>
        <field name="model">cashflow.report</field>
        <field name="arch" type="xml">
            <pivot string="Cashflow Report">
                <field name="month" type="row"/>
                <field name="cash_in" type="measure"/>
                <field name="cash_out" type="measure"/>
                <field name="net" type="measure"/>
                <field name="running_balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Cashflow Report Graph View - Running Balance -->
    <record id="view_cashflow_report_graph" model="ir.ui.view">
        <field name="name">cashflow.report.graph</field>
        <field name="model">cashflow.report</field>
        <field name="arch" type="xml">
            <graph string="Cashflow Forecast" type="line" stacked="0">
                <field name="date" interval="month"/>
                <field name="running_balance" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Cashflow Report Search View -->
    <record id="view_cashflow_report_search" model="ir.ui.view">
        <field name="name">cashflow.report.search</field>
        <field name="model">cashflow.report</field>
        <field name="arch" type="xml">
            <search string="Search Cashflow Report">
                <field name="month"/>
                <field name="journal_id"/>
                <filter name="filter_forecast" string="Forecast" domain="[('entry_type', '=', 'forecast')]"/>
                <filter name="filter_actual" string="Actual" domain="[('entry_type', '=', 'actual')]"/>
                <separator/>
                <filter name="group_journal" string="Bank" context="{'group_by': 'journal_id'}"/>
                <filter name="group_entry_type" string="Entry Type" context="{'group_by': 'entry_type'}"/>
            </search>
        </field>
    </record>

    <!-- Cashflow Analysis Action -->
    <record id="action_cashflow_report" model="ir.actions.act_window">
        <field name="name">Cashflow Analysis</field>
        <field name="res_model">cashflow.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_cashflow_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cashflow data available
            </p>
            <p>
                This report shows monthly cashflow with running balance.
            </p>
        </field>
    </record>

    <!-- Menu for Cashflow Analysis (under Management, like Invoice Analysis) -->
    <menuitem id="menu_cashflow_analysis"
              name="Cashflow Analysis"
              action="action_cashflow_report"
              parent="account.account_reports_management_menu"
              sequence="20"
              groups="account.group_account_readonly"/>

</odoo>
