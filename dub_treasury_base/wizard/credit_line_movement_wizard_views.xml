<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Credit Line Movement Wizard Form -->
    <record id="credit_line_movement_wizard_view_form" model="ir.ui.view">
        <field name="name">credit.line.movement.wizard.form</field>
        <field name="model">credit.line.movement.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Movement">
                <group>
                    <group>
                        <field name="credit_line_id" readonly="1"/>
                        <field name="movement_type"/>
                        <field name="amount"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="available_amount" string="Available"/>
                        <field name="used_amount" string="Used"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <group>
                    <field name="memo" placeholder="Description for journal entry..."/>
                    <field name="post_entry"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="credit_line_movement_wizard_action" model="ir.actions.act_window">
        <field name="name">Record Movement</field>
        <field name="res_model">credit.line.movement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_credit_line_id': active_id}</field>
    </record>

</odoo>
