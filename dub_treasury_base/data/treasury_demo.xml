<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- TREASURY ACCOUNTS                            -->
        <!-- ============================================ -->

        <record id="treasury_account_bank_intesa" model="treasury.account">
            <field name="name">Intesa Sanpaolo - C/C Principale</field>
            <field name="code">INTESA01</field>
            <field name="account_type">bank</field>
            <field name="iban">IT60X0542811101000000123456</field>
            <field name="notes">Conto corrente principale aziendale</field>
        </record>

        <record id="treasury_account_bank_unicredit" model="treasury.account">
            <field name="name">Unicredit - C/C Secondario</field>
            <field name="code">UNICREDIT01</field>
            <field name="account_type">bank</field>
            <field name="notes">Conto corrente secondario</field>
        </record>

        <record id="treasury_account_cash" model="treasury.account">
            <field name="name">Cassa Contanti</field>
            <field name="code">CASSA01</field>
            <field name="account_type">cash</field>
            <field name="notes">Cassa contanti sede principale</field>
        </record>

        <record id="treasury_account_internal" model="treasury.account">
            <field name="name">C/C Infragruppo</field>
            <field name="code">INFRA01</field>
            <field name="account_type">internal</field>
            <field name="notes">Conto per trasferimenti tra società del gruppo</field>
        </record>

        <!-- ============================================ -->
        <!-- CREDIT LINES                                 -->
        <!-- ============================================ -->

        <record id="credit_line_overdraft_intesa" model="treasury.credit.line">
            <field name="name">Scoperto C/C Intesa</field>
            <field name="account_id" ref="treasury_account_bank_intesa"/>
            <field name="credit_type">overdraft</field>
            <field name="limit_amount">50000.00</field>
            <field name="interest_rate">8.50</field>
            <field name="spread">2.00</field>
            <field name="commission_rate">0.50</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=6)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(DateTime.today() + relativedelta(months=6)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="contract_reference">SC-2024-001</field>
        </record>

        <record id="credit_line_advance_intesa" model="treasury.credit.line">
            <field name="name">Anticipo Fatture Intesa</field>
            <field name="account_id" ref="treasury_account_bank_intesa"/>
            <field name="credit_type">advance</field>
            <field name="limit_amount">100000.00</field>
            <field name="manual_used_amount">35000.00</field>
            <field name="auto_compute_usage" eval="False"/>
            <field name="interest_rate">6.50</field>
            <field name="spread">1.50</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=3)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(DateTime.today() + relativedelta(months=9)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="contract_reference">AF-2024-001</field>
        </record>

        <record id="credit_line_sbf_unicredit" model="treasury.credit.line">
            <field name="name">SBF Unicredit</field>
            <field name="account_id" ref="treasury_account_bank_unicredit"/>
            <field name="credit_type">sbf</field>
            <field name="limit_amount">75000.00</field>
            <field name="manual_used_amount">20000.00</field>
            <field name="auto_compute_usage" eval="False"/>
            <field name="interest_rate">5.75</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=12)).strftime('%Y-%m-%d')"/>
            <field name="expiry_date" eval="(DateTime.today() + relativedelta(months=12)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="contract_reference">SBF-2023-001</field>
        </record>

        <!-- Covenants -->
        <record id="covenant_debt_equity" model="treasury.covenant">
            <field name="name">Debt/Equity Ratio</field>
            <field name="credit_line_id" ref="credit_line_advance_intesa"/>
            <field name="covenant_type">debt_equity</field>
            <field name="comparison">&lt;=</field>
            <field name="threshold_value">2.5</field>
            <field name="current_value">1.8</field>
            <field name="frequency">quarterly</field>
            <field name="check_date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        </record>

        <record id="covenant_current_ratio" model="treasury.covenant">
            <field name="name">Current Ratio</field>
            <field name="credit_line_id" ref="credit_line_advance_intesa"/>
            <field name="covenant_type">current_ratio</field>
            <field name="comparison">&gt;=</field>
            <field name="threshold_value">1.2</field>
            <field name="current_value">1.45</field>
            <field name="frequency">quarterly</field>
            <field name="check_date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
        </record>

        <!-- ============================================ -->
        <!-- FINANCIAL INSTRUMENTS                        -->
        <!-- ============================================ -->

        <record id="instrument_loan_intesa" model="treasury.financial.instrument">
            <field name="name">Finanziamento Intesa 2024</field>
            <field name="instrument_type">loan</field>
            <field name="flow_direction">inbound</field>
            <field name="principal_amount">150000.00</field>
            <field name="disbursed_amount">150000.00</field>
            <field name="interest_rate">4.50</field>
            <field name="rate_type">fixed</field>
            <field name="amortization_type">french</field>
            <field name="installment_frequency">monthly</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=6)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today() + relativedelta(years=5)).strftime('%Y-%m-%d')"/>
            <field name="first_installment_date" eval="(DateTime.today() - relativedelta(months=5)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="reference">FIN-2024-001</field>
        </record>

        <record id="instrument_mortgage" model="treasury.financial.instrument">
            <field name="name">Mutuo Ipotecario Capannone</field>
            <field name="instrument_type">mortgage</field>
            <field name="flow_direction">inbound</field>
            <field name="principal_amount">500000.00</field>
            <field name="disbursed_amount">500000.00</field>
            <field name="interest_rate">3.20</field>
            <field name="rate_type">variable</field>
            <field name="reference_rate">euribor_3m</field>
            <field name="spread">1.50</field>
            <field name="amortization_type">french</field>
            <field name="installment_frequency">monthly</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(years=2)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today() + relativedelta(years=13)).strftime('%Y-%m-%d')"/>
            <field name="first_installment_date" eval="(DateTime.today() - relativedelta(years=2) + relativedelta(months=1)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="reference">MUT-2022-001</field>
            <field name="guarantee_type">mortgage</field>
            <field name="guarantee_notes">Ipoteca di primo grado su immobile industriale</field>
        </record>

        <record id="instrument_leasing_equipment" model="treasury.financial.instrument">
            <field name="name">Leasing Attrezzatura CNC</field>
            <field name="instrument_type">leasing</field>
            <field name="flow_direction">inbound</field>
            <field name="principal_amount">85000.00</field>
            <field name="disbursed_amount">85000.00</field>
            <field name="interest_rate">5.80</field>
            <field name="rate_type">fixed</field>
            <field name="amortization_type">french</field>
            <field name="installment_frequency">monthly</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=12)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today() + relativedelta(years=4)).strftime('%Y-%m-%d')"/>
            <field name="first_installment_date" eval="(DateTime.today() - relativedelta(months=11)).strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="reference">LEA-2023-001</field>
        </record>

        <record id="instrument_partner_loan_out" model="treasury.financial.instrument">
            <field name="name">Prestito a Consociata</field>
            <field name="instrument_type">partner_loan</field>
            <field name="flow_direction">outbound</field>
            <field name="principal_amount">30000.00</field>
            <field name="disbursed_amount">30000.00</field>
            <field name="interest_rate">3.00</field>
            <field name="rate_type">fixed</field>
            <field name="amortization_type">bullet</field>
            <field name="installment_frequency">quarterly</field>
            <field name="start_date" eval="(DateTime.today() - relativedelta(months=3)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today() + relativedelta(years=2)).strftime('%Y-%m-%d')"/>
            <field name="first_installment_date" eval="DateTime.today().strftime('%Y-%m-%d')"/>
            <field name="state">active</field>
            <field name="reference">PRT-2024-001</field>
        </record>

        <record id="instrument_loan_draft" model="treasury.financial.instrument">
            <field name="name">Nuovo Finanziamento (Bozza)</field>
            <field name="instrument_type">loan</field>
            <field name="flow_direction">inbound</field>
            <field name="principal_amount">200000.00</field>
            <field name="interest_rate">4.00</field>
            <field name="rate_type">fixed</field>
            <field name="amortization_type">italian</field>
            <field name="installment_frequency">quarterly</field>
            <field name="start_date" eval="(DateTime.today() + relativedelta(months=1)).strftime('%Y-%m-%d')"/>
            <field name="end_date" eval="(DateTime.today() + relativedelta(years=3)).strftime('%Y-%m-%d')"/>
            <field name="state">draft</field>
        </record>

    </data>
</odoo>
