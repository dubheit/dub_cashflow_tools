<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Treasury Financial Instrument Tree View -->
    <record id="treasury_financial_instrument_view_list" model="ir.ui.view">
        <field name="name">treasury.financial.instrument.list</field>
        <field name="model">treasury.financial.instrument</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('closed', 'cancelled')">
                <field name="name"/>
                <field name="reference" optional="show"/>
                <field name="instrument_type"/>
                <field name="flow_direction" optional="show"/>
                <field name="partner_id"/>
                <field name="principal_amount" sum="Total"/>
                <field name="residual_principal" sum="Total Residual"/>
                <field name="interest_rate" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state in ('draft', 'closed', 'cancelled')"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Treasury Financial Instrument Form View -->
    <record id="treasury_financial_instrument_view_form" model="ir.ui.view">
        <field name="name">treasury.financial.instrument.form</field>
        <field name="model">treasury.financial.instrument</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate_installments" string="Generate Installments" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_generate_disbursement_entry" string="Generate Disbursement Entry" type="object"
                            invisible="state != 'active' or disbursement_move_id" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'active'"
                            confirm="Are you sure you want to close this instrument?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'active')"
                            confirm="Are you sure you want to cancel this instrument?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="installment_count" widget="statinfo" string="Installments"/>
                        </button>
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <field name="disbursement_move_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Instrument Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main">
                            <field name="reference"/>
                            <field name="instrument_type"/>
                            <field name="flow_direction" widget="radio"/>
                            <field name="partner_id"/>
                            <field name="account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="amounts">
                            <field name="principal_amount"/>
                            <field name="disbursed_amount"/>
                            <field name="residual_principal"/>
                            <field name="total_interest"/>
                            <field name="total_paid"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <group name="interest" string="Interest">
                            <field name="rate_type"/>
                            <field name="interest_rate"/>
                            <field name="reference_rate" invisible="rate_type == 'fixed'"/>
                            <field name="spread" invisible="rate_type == 'fixed'"/>
                        </group>
                        <group name="dates" string="Dates">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="first_installment_date"/>
                        </group>
                    </group>
                    <group>
                        <group name="amortization" string="Amortization">
                            <field name="amortization_type"/>
                            <field name="installment_frequency"/>
                            <field name="total_installments"/>
                        </group>
                        <group name="guarantee" string="Guarantee">
                            <field name="guarantee_type"/>
                            <field name="guarantee_notes" invisible="guarantee_type == 'none'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments" name="installments">
                            <field name="installment_ids">
                                <list decoration-danger="state == 'overdue'" decoration-success="state == 'paid'" decoration-warning="state == 'due'">
                                    <field name="sequence"/>
                                    <field name="date"/>
                                    <field name="principal" sum="Total Principal"/>
                                    <field name="interest" sum="Total Interest"/>
                                    <field name="fees" sum="Total Fees" optional="show"/>
                                    <field name="total" sum="Total"/>
                                    <field name="residual_after" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-warning="state == 'due'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-muted="state == 'draft'"/>
                                    <field name="payment_date" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group string="Configuration">
                                    <field name="journal_id"/>
                                    <field name="long_term_account_id"/>
                                    <field name="short_term_account_id"/>
                                    <field name="interest_account_id"/>
                                    <field name="disbursement_account_id"/>
                                </group>
                                <group string="Options">
                                    <field name="enable_lt_st_reclassification"/>
                                    <field name="purpose"/>
                                </group>
                            </group>
                            <group string="Linked Documents">
                                <group>
                                    <field name="disbursement_move_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="vendor_bill_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Treasury Financial Instrument Search View -->
    <record id="treasury_financial_instrument_view_search" model="ir.ui.view">
        <field name="name">treasury.financial.instrument.search</field>
        <field name="model">treasury.financial.instrument</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="instrument_type"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="filter_loan" string="Loans" domain="[('instrument_type', '=', 'loan')]"/>
                <filter name="filter_mortgage" string="Mortgages" domain="[('instrument_type', '=', 'mortgage')]"/>
                <filter name="filter_leasing" string="Leasing" domain="[('instrument_type', '=', 'leasing')]"/>
                <filter name="filter_partner_loan" string="Partner Loans" domain="[('instrument_type', '=', 'partner_loan')]"/>
                <separator/>
                <filter name="filter_inbound" string="Inbound (Received)" domain="[('flow_direction', '=', 'inbound')]"/>
                <filter name="filter_outbound" string="Outbound (Granted)" domain="[('flow_direction', '=', 'outbound')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'instrument_type'}"/>
                    <filter name="group_partner" string="Counterpart" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_flow" string="Flow Direction" context="{'group_by': 'flow_direction'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="treasury_financial_instrument_action" model="ir.actions.act_window">
        <field name="name">Financial Instruments</field>
        <field name="res_model">treasury.financial.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="treasury_financial_instrument_view_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first financial instrument
            </p>
            <p>
                Financial instruments include loans, mortgages, leasing contracts,
                bonds, and partner loans.
            </p>
        </field>
    </record>

    <!-- Installment Views -->
    <record id="treasury_installment_view_list" model="ir.ui.view">
        <field name="name">treasury.installment.list</field>
        <field name="model">treasury.installment</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'overdue'" decoration-success="state == 'paid'" decoration-warning="state == 'due'">
                <field name="instrument_id"/>
                <field name="sequence"/>
                <field name="date"/>
                <field name="principal" sum="Total Principal"/>
                <field name="interest" sum="Total Interest"/>
                <field name="total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'due'"
                       decoration-danger="state == 'overdue'"
                       decoration-muted="state == 'draft'"/>
                <field name="payment_date"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="treasury_installment_view_form" model="ir.ui.view">
        <field name="name">treasury.installment.form</field>
        <field name="model">treasury.installment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_due" string="Set Due" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_generate_payment_entry" string="Generate Entry" type="object"
                            invisible="state not in ('due', 'overdue') or is_payment_move_posted" class="oe_highlight"/>
                    <button name="action_mark_paid" string="Mark Paid" type="object"
                            invisible="state not in ('due', 'overdue')" class="oe_highlight"/>
                    <button name="action_create_payment" string="Create Payment" type="object"
                            invisible="state not in ('due', 'overdue')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,due,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not generated_move_ids">
                            <span class="o_stat_text">Entries</span>
                        </button>
                    </div>
                    <field name="is_payment_move_posted" invisible="1"/>
                    <group>
                        <group>
                            <field name="instrument_id"/>
                            <field name="sequence"/>
                            <field name="date"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="principal"/>
                            <field name="interest"/>
                            <field name="fees"/>
                            <field name="insurance"/>
                            <field name="total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="residual_before"/>
                            <field name="residual_after"/>
                        </group>
                        <group>
                            <field name="payment_id"/>
                            <field name="move_id"/>
                            <field name="vendor_bill_id"/>
                        </group>
                    </group>
                    <separator string="Generated Entries" invisible="not generated_move_ids"/>
                    <field name="generated_move_ids" invisible="not generated_move_ids">
                        <list>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="ref"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="treasury_installment_view_search" model="ir.ui.view">
        <field name="name">treasury.installment.search</field>
        <field name="model">treasury.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="instrument_id"/>
                <field name="partner_id"/>
                <filter name="filter_due" string="Due" domain="[('state', '=', 'due')]"/>
                <filter name="filter_overdue" string="Overdue" domain="[('state', '=', 'overdue')]"/>
                <filter name="filter_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;', ((context_today().replace(day=1) + relativedelta(months=1))).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_next_30_days" string="Next 30 Days"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_instrument" string="Instrument" context="{'group_by': 'instrument_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Due Date" context="{'group_by': 'date:month'}"/>
                    <filter name="group_partner" string="Counterpart" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="treasury_installment_action" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">treasury.installment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="treasury_installment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No installments found
            </p>
            <p>
                Installments are automatically generated from financial instruments.
            </p>
        </field>
    </record>

    <!-- Calendar view for installments -->
    <record id="treasury_installment_view_calendar" model="ir.ui.view">
        <field name="name">treasury.installment.calendar</field>
        <field name="model">treasury.installment</field>
        <field name="arch" type="xml">
            <calendar string="Installments" date_start="date" color="instrument_type" mode="month">
                <field name="instrument_id"/>
                <field name="total"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="treasury_installment_action_calendar" model="ir.actions.act_window">
        <field name="name">Installments Calendar</field>
        <field name="res_model">treasury.installment</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="treasury_installment_view_search"/>
    </record>

</odoo>
