<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Treasury Security Groups -->
    <record id="module_category_treasury" model="ir.module.category">
        <field name="name">Treasury</field>
        <field name="description">Treasury Management</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_treasury_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_treasury"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
        <field name="comment">Basic treasury user: can view treasury data and update balances</field>
    </record>

    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_user')), (4, ref('account.group_account_user'))]"/>
        <field name="comment">Treasury manager: full access to treasury features</field>
    </record>

    <!-- Record Rules -->

    <!-- Multi-company rule for treasury.account -->
    <record id="treasury_account_company_rule" model="ir.rule">
        <field name="name">Treasury Account: multi-company</field>
        <field name="model_id" ref="model_treasury_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rule for treasury.credit.line -->
    <record id="treasury_credit_line_company_rule" model="ir.rule">
        <field name="name">Treasury Credit Line: multi-company</field>
        <field name="model_id" ref="model_treasury_credit_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rule for treasury.financial.instrument -->
    <record id="treasury_financial_instrument_company_rule" model="ir.rule">
        <field name="name">Treasury Financial Instrument: multi-company</field>
        <field name="model_id" ref="model_treasury_financial_instrument"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Multi-company rule for treasury.installment -->
    <record id="treasury_installment_company_rule" model="ir.rule">
        <field name="name">Treasury Installment: multi-company</field>
        <field name="model_id" ref="model_treasury_installment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
