<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Presented effetti: forecast on the bank of the credit line, in
             place of the invoice installments they contain (see
             cashflow.config._is_superseded) -->
        <record id="cashflow_config_riba_slip_line" model="cashflow.config">
            <field name="name">Presented RiBa Cashflow</field>
            <field name="model_id" ref="l10n_it_riba_oca.model_riba_slip_line"/>
            <field name="filter_domain">[('state', 'in', ('confirmed', 'credited'))]</field>
            <field name="name_code">'%s %s' % (record.slip_id.name or '', record.partner_id.name or '')</field>
            <field name="active">True</field>
        </record>

        <record id="cashflow_config_line_riba_state" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">5</field>
            <field name="cashflow_field">state</field>
            <field name="source_type">fixed_value</field>
            <field name="fixed_value">confirmed</field>
        </record>

        <record id="cashflow_config_line_riba_entry_type" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">6</field>
            <field name="cashflow_field">entry_type</field>
            <field name="source_type">fixed_value</field>
            <field name="fixed_value">forecast</field>
        </record>

        <record id="cashflow_config_line_riba_date" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">10</field>
            <field name="cashflow_field">date</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.due_date</field>
        </record>

        <record id="cashflow_config_line_riba_amount" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">20</field>
            <field name="cashflow_field">amount</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.amount</field>
        </record>

        <record id="cashflow_config_line_riba_type" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">30</field>
            <field name="cashflow_field">type</field>
            <field name="source_type">fixed_value</field>
            <field name="fixed_value">in</field>
        </record>

        <record id="cashflow_config_line_riba_currency" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">40</field>
            <field name="cashflow_field">currency_id</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.slip_id.company_id.currency_id.id</field>
        </record>

        <record id="cashflow_config_line_riba_partner" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">50</field>
            <field name="cashflow_field">partner_id</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.partner_id.id</field>
        </record>

        <record id="cashflow_config_line_riba_description" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">60</field>
            <field name="cashflow_field">description</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.slip_id.name or ''</field>
        </record>

        <!-- Bank journal of the castelletto the slip is presented on -->
        <record id="cashflow_config_line_riba_journal" model="cashflow.config.line">
            <field name="config_id" ref="cashflow_config_riba_slip_line"/>
            <field name="sequence">70</field>
            <field name="cashflow_field">journal_id</field>
            <field name="source_type">python_code</field>
            <field name="python_code">record.slip_id.config_id.credit_line_id.account_id.journal_id.id or False</field>
        </record>
    </data>
</odoo>
